datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================
// UNIVERSITY & DEPARTMENT
// ============================================================

model University {
  id          String       @id @default(uuid())
  name        String
  code        String       @unique
  domain      String       @unique
  location    String
  departments Department[]
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("universities")
}

model Department {
  id           String     @id @default(uuid())
  name         String
  code         String
  universityId String
  university   University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  users        User[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([universityId], map: "idx_departments_university_id")
  @@map("departments")
}

// ============================================================
// USER MANAGEMENT
// ============================================================

model User {
  id             String      @id @default(uuid())
  name           String
  studentId      String      @unique
  email          String      @unique
  password       String
  academicYear   String
  course         String
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  universityId   String?
  university     University? @relation(fields: [universityId], references: [id], onDelete: SetNull)
  avatar         String?
  linkedin       String?
  github         String?
  bio            String?
  experience     String?
  availability   String?     @default("Flexible")
  preferredRoles String[]    @default([])
  emailVerified  Boolean     @default(false)
  role           String      @default("STUDENT")

  skills              UserSkill[]
  interests           UserInterest[]
  communicationSkills UserCommunicationSkill[]
  languages           UserLanguage[]
  preferences         UserPreference?
  createdProjects     Project[]                @relation("ProjectCreator")
  ledTeams            Team[]                   @relation("TeamLeader")
  teamMemberships     TeamMember[]
  teamRequests        TeamRequest[]
  assignedTasks       Task[]                   @relation("TaskAssignee")
  createdTasks        Task[]                   @relation("TaskCreator")
  sentMessages        Message[]
  notifications       Notification[]
  givenFeedback       PeerFeedback[]           @relation("FeedbackFrom")
  receivedFeedback    PeerFeedback[]           @relation("FeedbackTo")
  passwordResetTokens PasswordResetToken[]
  showcaseVideos      ShowcaseVideo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId], map: "idx_users_department_id")
  @@index([universityId], map: "idx_users_university_id")
  @@map("users")
}

// ============================================================
// SKILLS MANAGEMENT
// ============================================================

model Skill {
  id            String         @id @default(uuid())
  name          String         @unique
  category      String
  description   String?
  userSkills    UserSkill[]
  projectSkills ProjectSkill[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("skills")
}

model UserSkill {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  proficiency Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, skillId])
  @@index([skillId], map: "idx_user_skills_skill_id")
  @@map("user_skills")
}

model UserInterest {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest  String
  createdAt DateTime @default(now())

  @@unique([userId, interest])
  @@map("user_interests")
}

// ============================================================
// PROJECT MANAGEMENT
// ============================================================

model Project {
  id                       String                           @id @default(uuid())
  title                    String
  description              String
  projectType              String
  requiredTeamSize         Int                              @default(4)
  difficulty               String                           @default("Intermediate")
  deadline                 DateTime?
  status                   String                           @default("RECRUITING")
  creatorId                String
  creator                  User                             @relation("ProjectCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  skills                   ProjectSkill[]
  roles                    ProjectRole[]
  team                     Team?
  communicationRequirement ProjectCommunicationRequirement?
  repositories             Repository[]
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt

  @@index([creatorId], map: "idx_projects_creator_id")
  @@map("projects")
}

model ProjectSkill {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skillId    String
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  importance Int      @default(3)
  createdAt  DateTime @default(now())

  @@unique([projectId, skillId])
  @@index([skillId], map: "idx_project_skills_skill_id")
  @@map("project_skills")
}

model ProjectRole {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  roleName  String
  openCount Int      @default(1)
  createdAt DateTime @default(now())

  @@index([projectId], map: "idx_project_roles_project_id")
  @@map("project_roles")
}

model Repository {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repoUrl   String
  provider  String   @default("GITHUB")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId], map: "idx_repositories_project_id")
  @@map("repositories")
}

// ============================================================
// TEAM MANAGEMENT
// ============================================================

model Team {
  id            String         @id @default(uuid())
  name          String
  projectId     String         @unique
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  leaderId      String
  leader        User           @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: Cascade)
  members       TeamMember[]
  requests      TeamRequest[]
  tasks         Task[]
  messages      Message[]
  peerFeedbacks PeerFeedback[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([leaderId], map: "idx_teams_leader_id")
  @@map("teams")
}

model TeamMember {
  id       String   @id @default(uuid())
  teamId   String
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("Member")
  joinedAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId], map: "idx_team_members_user_id")
  @@map("team_members")
}

model TeamRequest {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, userId])
  @@index([userId], map: "idx_team_requests_user_id")
  @@map("team_requests")
}

// ============================================================
// TASK MANAGEMENT
// ============================================================

model Task {
  id           String    @id @default(uuid())
  teamId       String
  team         Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  assignedToId String?
  assignedTo   User?     @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  priority     String    @default("MEDIUM")
  status       String    @default("TODO")
  dueDate      DateTime?
  createdById  String
  createdBy    User      @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([assignedToId], map: "idx_tasks_assigned_to_id")
  @@index([createdById], map: "idx_tasks_created_by_id")
  @@index([teamId], map: "idx_tasks_team_id")
  @@map("tasks")
}

// ============================================================
// MESSAGING
// ============================================================

model Message {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@index([senderId], map: "idx_messages_sender_id")
  @@index([teamId], map: "idx_messages_team_id")
  @@map("messages")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("SYSTEM")
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId], map: "idx_notifications_user_id")
  @@map("notifications")
}

// ============================================================
// COMMUNICATION SKILLS
// ============================================================

model CommunicationSkill {
  id          String                   @id @default(uuid())
  name        String                   @unique
  description String?
  userSkills  UserCommunicationSkill[]
  createdAt   DateTime                 @default(now())

  @@map("communication_skills")
}

model UserCommunicationSkill {
  id                   String             @id @default(uuid())
  userId               String
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  communicationSkillId String
  communicationSkill   CommunicationSkill @relation(fields: [communicationSkillId], references: [id], onDelete: Cascade)
  proficiency          Int                @default(3)
  createdAt            DateTime           @default(now())

  @@unique([userId, communicationSkillId])
  @@index([communicationSkillId], map: "idx_user_communication_skills_skill_id")
  @@map("user_communication_skills")
}

// ============================================================
// USER LANGUAGES & PREFERENCES
// ============================================================

model UserLanguage {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language    String
  proficiency String   @default("Fluent")
  createdAt   DateTime @default(now())

  @@unique([userId, language])
  @@map("user_languages")
}

model UserPreference {
  id                   String   @id @default(uuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  communicationMethods String[] @default(["Text-based communication", "Voice discussions"])
  collaborationStyle   String   @default("Brainstorming together")
  availability         String   @default("Flexible")
  themeMode            String   @default("light")
  themeIntensity       String   @default("classic")
  emailNotifications   Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("user_preferences")
}

// ============================================================
// PROJECT COMMUNICATION REQUIREMENTS
// ============================================================

model ProjectCommunicationRequirement {
  id               String   @id @default(uuid())
  projectId        String   @unique
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  preferredStyle   String?
  meetingFrequency String?
  primaryLanguage  String   @default("English")
  createdAt        DateTime @default(now())

  @@map("project_communication_requirements")
}

// ============================================================
// EMAIL VERIFICATION
// ============================================================

model EmailVerification {
  id        String   @id @default(uuid())
  email     String
  otpHash   String   @map("otp")
  token     String   @unique
  expiresAt DateTime
  attempts  Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("email_verifications")
}

// ============================================================
// PASSWORD RESET
// ============================================================

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId], map: "idx_password_reset_tokens_user_id")
  @@map("password_reset_tokens")
}

// ============================================================
// PEER FEEDBACK
// ============================================================

model PeerFeedback {
  id         String   @id @default(uuid())
  fromUserId String
  fromUser   User     @relation("FeedbackFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User     @relation("FeedbackTo", fields: [toUserId], references: [id], onDelete: Cascade)
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@index([fromUserId], map: "idx_peer_feedback_from_user_id")
  @@index([teamId], map: "idx_peer_feedback_team_id")
  @@index([toUserId], map: "idx_peer_feedback_to_user_id")
  @@map("peer_feedback")
}

// ============================================================
// SHOWCASE VIDEOS
// ============================================================

model ShowcaseVideo {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  category     String
  description  String?
  storageKey   String
  videoUrl     String
  thumbnailUrl String?
  duration     Int      @default(60)
  skillTags    String[] @default([])
  visibility   String   @default("PUBLIC")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId], map: "idx_showcase_videos_user_id")
  @@map("showcase_videos")
}
