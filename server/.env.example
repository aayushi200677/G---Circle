# G-CIRCLE Server Environment Variables
PORT=5002
NODE_ENV=development

# PostgreSQL Database Connection
# If using embedded PostgreSQL or local PostgreSQL:
DATABASE_URL="postgresql://postgres:password@localhost:5433/g_circle_new?schema=public"

# JWT Authentication
JWT_SECRET="gcircle_super_secure_jwt_secret_university_2026_key"
JWT_EXPIRES_IN="7d"

# University Email Settings (Galgotias University)
EMAIL_SERVICE_ENABLED=false
EMAIL_HOST="smtp.ethereal.email"
EMAIL_PORT=587
EMAIL_USER=""
